{
  "name": "orbbound",
  "version": "3.3.0",
  "private": true,
  "description": "A modern, deterministic bubble-puzzle game inspired by classic connect-and-drop rules.",
  "main": "electron/main.cjs",
  "author": "Orbbound",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:win": "tsc --noEmit && vite build --mode windows",
    "dev:win": "vite --mode windows",
    "package:win": "npm run build:win && node scripts/package-win.cjs",
    "sync:android": "npm run build && cap sync android",
    "package:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-android.ps1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "24.3.0",
    "7zip-bin": "5.2.0",
    "electron": "37.3.1",
    "electron-builder": "26.0.12",
    "phaser": "3.90.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  }
}
