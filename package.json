{
  "name": "orbbound",
  "version": "1.2.0",
  "private": true,
  "description": "A modern, deterministic bubble-puzzle game inspired by classic connect-and-drop rules.",
  "main": "electron/main.cjs",
  "author": "Orbbound",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "phaser": "3.90.0",
    "@types/node": "24.3.0",
    "electron": "37.3.1",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.orbbound.game",
    "productName": "Orbbound",
    "directories": {
      "output": "最终交付/Orbbound-1.2.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": ["zh-CN", "en-US"],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Orbbound-Portable-${version}.exe"
    }
  }
}

